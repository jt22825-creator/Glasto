{
  "name": "name-royale",
  "version": "0.1.0",
  "private": true,
  "description": "A chat-plays battle royale for YouTube live streams. Type !join to play.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "sim": "node server/index.ts --source=sim",
    "live": "node server/index.ts --source=youtube",
    "youtube:check": "node server/youtube/check.ts",
    "server": "node server/index.ts --source=none",
    "game": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/youtube.test.ts tests/leaderboard.test.ts tests/obs.test.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "phaser": "^3.90.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
